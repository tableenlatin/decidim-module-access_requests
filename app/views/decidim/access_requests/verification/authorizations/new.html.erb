<div class="text-center py-10">
  <h1 class="title-decorator inline-block text-left">
    <%= t(".title") %>
  </h1>
</div>

<%= render "steps", active: [0] %>

<%= decidim_form_for(@form, url: authorization_path) do |form| %>
  <%= form_required_explanation %>

  <div class="form__wrapper">
    <%= form.hidden_field :handler_handle %>

    <%= form.text_field :membership_number,
                        required: true,
                        help_text: t(".membership_number_help") %>
  </div>

  <div class="form__wrapper-block flex-col-reverse md:flex-row justify-end">
    <button type="submit" class="button button__sm md:button__lg button__secondary" data-disable-with="<%= t('.send') %>...">
      <span><%= t(".send") %></span>
      <%= icon "arrow-right-line", class: "fill-current" %>
    </button>
  </div>
<% end %>
